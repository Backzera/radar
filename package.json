{
  "name": "agio",
  "version": "2.0.0-rc.1",
  "private": true,
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/dev-local.mjs",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "test": "node scripts/test.mjs",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node scripts/migrate.mjs",
    "worker": "node scripts/worker.mjs",
    "local:init": "node scripts/init-local.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "doctor": "node scripts/doctor.mjs",
    "demo:purge": "node scripts/demo-purge.mjs",
    "check-secrets": "node scripts/check-secrets.mjs",
    "build:production": "node scripts/build-production.mjs",
    "preview:compiled": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "check:source-secrets": "node scripts/check-secrets.mjs --source-only",
    "backup": "node scripts/backup.mjs",
    "retention:report": "node scripts/retention-report.mjs",
    "test:browser:prepare": "npm test && node tests/browser/build.mjs",
    "test:browser:serve": "node tests/browser/server.mjs --seed",
    "benchmark": "node scripts/benchmark.cjs after",
    "probe:marketplace": "node scripts/probe-marketplace.mjs",
    "dev:server": "node scripts/run-framework.mjs dev",
    "local:upgrade": "node scripts/upgrade-local.mjs",
    "vps:build": "node scripts/build-vps.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.31.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "prettier": "^3.9.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
