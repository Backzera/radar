# Copie este arquivo para .dev.vars (ambiente local) e mantenha fora do Git.
# Sem credenciais externas, o painel fica sem dados reais. Fixtures existem só em tests.
BRIGHTDATA_API_KEY=
BRIGHTDATA_DATASET_ID=gd_lvt9iwuh6fbcwmx1a
# Só confirme após verificar contrato/licença/permissão aplicáveis aos dados.
# Este campo NÃO concede autorização da Meta.
FACEBOOK_DATA_RIGHTS_CONFIRMED=false
PILOT_MODE=true
MAX_DAILY_PROVIDER_TRIGGERS=5
BRIGHTDATA_MAX_RECORDS_PER_TRIGGER=10
EXTERNAL_ALERTS_ENABLED=false

# Worker independente: token gerado por npm run local:init, sem exibir o segredo.
WORKER_TOKEN=
# WORKER_USER_ID é legado; o scheduler atende contas elegíveis sem trocar ownership.
RADAR_API_URL=http://localhost:5173
WORKER_TICK_MS=10000

# Opcional: destinos verificados por conta; nunca configurados pelo cliente final.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Operação sempre real; fixtures existem apenas em tests.
# O limite acima não aumenta ao escolher 25/50 no monitor.
# Para permitir 25, altere BRIGHTDATA_MAX_RECORDS_PER_TRIGGER conscientemente.
# PILOT_MODE=false habilita scheduler pago automático; mantenha true no início.

# Segurança. "password" = cadastro e login por e-mail e senha do próprio app (SaaS).
# Outros modos: cloudflare-access (equipe interna) e local-development.
AUTH_MODE=password
# E-mails com acesso à área administrativa, separados por vírgula.
RADAR_ADMIN_EMAILS=
ACCESS_ISSUER=
ACCESS_AUDIENCE=
RADAR_ADMIN_IDS=
# Acesso sem identidade externa só existe em desenvolvimento, na origem loopback.
ALLOW_LOCAL_DEV_AUTH=false
# Somente plataforma com proxy confiável, origem protegida e segredo injetado:
TRUST_PLATFORM_IDENTITY=false
PLATFORM_ORIGIN_TOKEN=
# Trava adicional. false impede novos disparos, mesmo fora do piloto.
COLLECTION_ENABLED=false
# Credenciais de serviço Access do worker, quando a borda exigir.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
ALLOW_INSECURE_LOCAL_WORKER_HTTP=false

# Conferências adicionais por anúncio: desativadas até autorização de custo.
AVAILABILITY_ENABLED=false
AUTO_VERIFY_OPPORTUNITIES=false
MAX_DAILY_AVAILABILITY_CHECKS=1
