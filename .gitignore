# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.dev.vars*

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
# Checkout-local execution profile and tool state; never publish them.
/.sites-runtime/
/.agents/
/.codex/
/outputs/
/work/
/.test-build/
/*.tsbuildinfo
/npm.cmd
!/.env.example

.browser-build/

.schema-build/

wrangler.production.json
backups/

# Pages saved by the collector probe hold third-party public data; never publish.
.probe-output/

# Configuração local do Claude Code (servidor de preview).
/.claude/

# Pacote gerado para a VPS (npm run vps:build).
/release/
