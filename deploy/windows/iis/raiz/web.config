<?xml version="1.0" encoding="UTF-8"?>
<!--
  Raiz do site {{HOST}}, usada só quando o configurar-iis.ps1 cria o site.
  Tudo fora de {{BASE}} leva para o app; {{BASE}} é atendido pela pasta ..\app.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Raiz para o Market Radar" stopProcessing="true">
          <match url=".*" />
          <action type="Redirect" url="{{ORIGIN}}{{BASE}}" redirectType="Found" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
