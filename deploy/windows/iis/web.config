<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS na frente do Market Radar (LEIA-ME.md, "Opção A").
  Precisa dos módulos URL Rewrite e Application Request Routing (ARR) com o proxy ligado.
  Site novo: aponte o "Caminho físico" do site {{HOST}} para esta pasta.
  Site que já existe: copie as duas regras e o bloco <location> para o web.config dele.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- {UNENCODED_URL} já traz a query string, por isso appendQueryString="false". -->
        <rule name="Market Radar (brique)" stopProcessing="true">
          <match url="^{{BASE_NO_SLASH}}(/.*)?$" />
          <action type="Rewrite" url="http://127.0.0.1:{{PORT}}{UNENCODED_URL}" appendQueryString="false" />
        </rule>
        <!-- A raiz do domínio leva para o app (apague se já houver outro site na raiz). -->
        <rule name="Raiz para o Market Radar" stopProcessing="true">
          <match url="^$" />
          <action type="Redirect" url="{{BASE}}" redirectType="Found" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
  <!-- Deixa passar as mensagens de erro do app em vez da página padrão do IIS. -->
  <location path="{{BASE_NO_SLASH}}">
    <system.webServer>
      <httpErrors existingResponse="PassThrough" />
    </system.webServer>
  </location>
</configuration>
