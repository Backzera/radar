<?xml version="1.0" encoding="UTF-8"?>
<!--
  Market Radar: a aplicação {{BASE}} do IIS repassa tudo para o app (porta {{PORT}}).
  O configurar-iis.ps1 aponta a aplicação {{BASE}} do site {{HOST}} para esta pasta.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- Ignora as regras do site principal (ex.: outro sistema na raiz do domínio). -->
        <clear />
        <!-- www.{{HOST}} -> {{HOST}} (o login só vale no endereço principal) -->
        <rule name="Market Radar - sem www" stopProcessing="true">
          <match url=".*" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^www\." />
          </conditions>
          <action type="Redirect" url="{{ORIGIN}}{UNENCODED_URL}" redirectType="Permanent" appendQueryString="false" />
        </rule>
        <!-- {UNENCODED_URL} já traz o {{BASE}} e a query string. -->
        <rule name="Market Radar" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="http://127.0.0.1:{{PORT}}{UNENCODED_URL}" appendQueryString="false" />
        </rule>
      </rules>
      <outboundRules>
        <clear />
      </outboundRules>
    </rewrite>
    <security>
      <requestFiltering allowDoubleEscaping="true" />
    </security>
    <!-- Deixa passar as mensagens de erro do app em vez da página padrão do IIS. -->
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
