{
  "name": "market-radar",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "market-radar-existing",
      "database_id": "REPLACE_WITH_EXISTING_D1_ID",
      "migrations_dir": "drizzle"
    }
  ],
  "vars": {
    "AUTH_MODE": "password",
    "ALLOW_LOCAL_DEV_AUTH": "false",
    "COLLECTION_ENABLED": "false",
    "PILOT_MODE": "true",
    "EXTERNAL_ALERTS_ENABLED": "false"
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "market-radar-media"
    }
  ]
}
